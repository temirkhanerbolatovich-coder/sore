# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ИИ-карточка (только сервер, не добавляйте NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=20

# Публичный адрес сайта (для OG-ссылок)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Демо-магазин (slug из supabase/seed.sql)
DEMO_SLUG=demo

# Только сервер: атомарный лимит ИИ, не публиковать
SUPABASE_SERVICE_ROLE_KEY=
AI_MODEL=claude-sonnet-5-5
